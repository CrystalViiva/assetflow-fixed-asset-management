# Django backend
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=false
SECURE_SSL_REDIRECT=false
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Africa/Lagos
# PostgreSQL is the expected database for both application and test environments.
DATABASE_URL=postgresql://assetflow:replace-with-a-local-development-password@localhost:5432/assetflow
POSTGRES_PASSWORD=replace-with-a-local-development-password
DB_CONN_MAX_AGE=60
LOG_LEVEL=INFO
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
EVIDENCE_MAX_UPLOAD_BYTES=20971520
REPORT_EXPORT_MAX_BYTES=104857600
REPORT_EXPORT_RETENTION_DAYS=30
ANALYTICS_MAX_RECORDS_PER_RUN=100000
ANALYTICS_MAX_OUTPUT_BYTES=262144000
ANALYTICS_LATE_ARRIVAL_OVERLAP_HOURS=48
# Private storage defaults to backend/private_media via the assetflow_private alias.
# To replace it, set ASSETFLOW_PRIVATE_STORAGE_BACKEND and JSON
# ASSETFLOW_PRIVATE_STORAGE_OPTIONS for the chosen private Django storage backend.
# Analytics JSONL outputs use a separate non-public assetflow_analytics alias.
# Configure ASSETFLOW_ANALYTICS_STORAGE_BACKEND and JSON
# ASSETFLOW_ANALYTICS_STORAGE_OPTIONS for shared private object storage in deployment.

# Frontend: mock demo or authenticated Django integration
VITE_DATA_SOURCE=mock
VITE_BACKEND_API_URL=/api/v1
# Vite development proxy only; never shipped in the browser bundle
DJANGO_DEV_PROXY_TARGET=http://127.0.0.1:8000

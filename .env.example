# Example values only. This file is safe to commit; copy it for local use and
# replace the placeholders. Never use these values as production credentials.
# REQUIRED for Django: DJANGO_SECRET_KEY and DATABASE_URL.
# REQUIRED for Compose: POSTGRES_PASSWORD and DJANGO_SECRET_KEY.
# DEVELOPMENT defaults below are suitable only for a local workstation.
# Django backend
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=false
ASSETFLOW_ENV=development
SECURE_SSL_REDIRECT=false
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
TIME_ZONE=Africa/Lagos
# PostgreSQL is the expected database for both application and test environments.
DATABASE_URL=postgresql://assetflow:replace-with-a-local-development-password@localhost:5432/assetflow
POSTGRES_PASSWORD=replace-with-a-local-development-password
DB_CONN_MAX_AGE=60
LOG_LEVEL=INFO
DEFAULT_FROM_EMAIL=AssetFlow <no-reply@localhost>
FRONTEND_BASE_URL=http://localhost:3000
# Trust only the network of the reverse proxy that overwrites X-Real-IP.
# Empty locally: use the TCP client address for throttling.
TRUSTED_PROXY_NETWORKS=
# Production frontend also needs the actual TLS ingress peer CIDR, never 0.0.0.0/0.
ASSETFLOW_INGRESS_PROXY_CIDR=127.0.0.1/32
# Leave the console backend for local/test use. Configure SMTP/provider secrets outside source control.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Staging accepts console, file capture or locmem only. Production requires SMTP.
EMAIL_FILE_PATH=
# Sandbox only. Production defaults to self-service off and billing disabled.
SELF_SERVICE_ENABLED=true
BILLING_PROVIDER=local_sandbox
# Optional Paystack TEST key for BILLING_PROVIDER=paystack_test. Never use sk_live_.
PAYSTACK_SECRET_KEY=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
EVIDENCE_MAX_UPLOAD_BYTES=20971520
REPORT_EXPORT_MAX_BYTES=104857600
REPORT_EXPORT_RETENTION_DAYS=30
ANALYTICS_MAX_RECORDS_PER_RUN=100000
ANALYTICS_MAX_OUTPUT_BYTES=262144000
ANALYTICS_LATE_ARRIVAL_OVERLAP_HOURS=48
# Private storage defaults to backend/private_media via the assetflow_private alias.
# To replace it, set ASSETFLOW_PRIVATE_STORAGE_BACKEND and JSON
# ASSETFLOW_PRIVATE_STORAGE_OPTIONS for the chosen private Django storage backend.
# Analytics JSONL outputs use a separate non-public assetflow_analytics alias.
# Configure ASSETFLOW_ANALYTICS_STORAGE_BACKEND and JSON
# ASSETFLOW_ANALYTICS_STORAGE_OPTIONS for shared private object storage in deployment.

# Frontend: mock demo or authenticated Django integration
VITE_DATA_SOURCE=mock
VITE_BACKEND_API_URL=/api/v1
# Vite development proxy only; never shipped in the browser bundle
DJANGO_DEV_PROXY_TARGET=http://127.0.0.1:8000

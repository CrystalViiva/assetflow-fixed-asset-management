# Django backend
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Africa/Lagos
# Production/development with Docker: postgresql://assetflow:assetflow@localhost:5432/assetflow
# Leave unset to use the local SQLite development database.
# DATABASE_URL=postgresql://assetflow:assetflow@localhost:5432/assetflow
DB_CONN_MAX_AGE=60
LOG_LEVEL=INFO

# Frontend (optional)
VITE_BACKEND_API_URL=http://localhost:8000/api/v1
# GEMINI_API_KEY=
# APP_URL=http://localhost:3000
